# FUTUREKAWA — variables d'environnement (référence racine)

# Chaque sous-projet garde son PROPRE fichier .env :

#   central-backend/.env   → DATABASE_URL (Supabase) + COL_API_KEY
#   local-country/.env     → POSTGRES_*, API_KEY, SMTP_* (Brevo)

#  central-backend/.env
# DATABASE_URL=postgresql://postgres.<ref>:<MOT_DE_PASSE>@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# COL_API_KEY=<clé X-API-Key du backend local Colombie>
# COL_API_BASE_URL=http://localhost:8000
# BRA_API_KEY=           # pays en mode MOCK, non requis
# ECU_API_KEY=           # pays en mode MOCK, non requis
# SYNC_INTERVAL_SECONDS=300

#  local-country/.env
# POSTGRES_USER=futurekawa
# POSTGRES_PASSWORD=futurekawa
# POSTGRES_DB=futurekawa_local
# DATABASE_URL=postgresql+psycopg2://futurekawa:futurekawa@localhost:5432/futurekawa_local
# API_KEY=change-me
# ALERTE_LOTS_INTERVAL_SECONDS=3600
# SMTP_SERVER=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@futurekawa.com