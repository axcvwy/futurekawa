# Copiez ce fichier vers .env puis renseignez les valeurs réelles.
# .env est ignoré par Git (voir .gitignore) et ne doit JAMAIS être commité.

# Base de données PostgreSQL centrale (Supabase) — OBLIGATOIRE
# DATABASE_URL=postgresql://postgres.<ref>:<MOT_DE_PASSE>@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Clé X-API-Key du backend local Équateur (réel)
# ECU_API_KEY=
# ECU_API_BASE_URL=http://localhost:8000

# (Optionnel) Backends locaux Brésil / Colombie (actuellement en mode MOCK)
# BRA_API_KEY=
# BRA_API_BASE_URL=http://localhost:8000
# COL_API_KEY=
# COL_API_BASE_URL=http://localhost:8001

# (Optionnel) Réglages de synchronisation
# SYNC_INTERVAL_SECONDS=300
# SYNC_OVERLAP_SECONDS=120
# SYNC_PAGE_SIZE=100
# SYNC_REQUEST_TIMEOUT=10
# SCHEDULER_POLL_SECONDS=30

# Clé du flux d'intégration ERP (header X-ERP-Key). Valeur de dev ; à changer en production.
# ERP_API_KEY=futurekawa-erp-dev-key
